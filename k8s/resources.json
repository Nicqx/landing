[
  {"apiVersion":"v1","kind":"ConfigMap","metadata":{"name":"landing-page"},"data":{}},
  {"apiVersion":"v1","kind":"ConfigMap","metadata":{"name":"landing-nginx"},"data":{}},
  {"apiVersion":"apps/v1","kind":"Deployment","metadata":{"name":"landing-page-deployment","labels":{"app":"landing-page"}},"spec":{
    "replicas":1,"strategy":{"type":"Recreate"},"selector":{"matchLabels":{"app":"landing-page"}},
    "template":{"metadata":{"labels":{"app":"landing-page"}},"spec":{
      "automountServiceAccountToken":false,
      "securityContext":{"runAsNonRoot":true,"runAsUser":1000,"runAsGroup":1000,"fsGroup":1000,"seccompProfile":{"type":"RuntimeDefault"}},
      "containers":[{"name":"nginx","image":"nginx:stable-alpine@sha256:ef8676b33d681f272ba429b27658bdd7e640963279714c96bddf1dc76307f7b6","imagePullPolicy":"IfNotPresent",
        "command":["nginx","-g","daemon off;"],"ports":[{"name":"http","containerPort":8080}],
        "securityContext":{"allowPrivilegeEscalation":false,"readOnlyRootFilesystem":true,"capabilities":{"drop":["ALL"]}},
        "resources":{"requests":{"cpu":"10m","memory":"16Mi"},"limits":{"cpu":"200m","memory":"96Mi"}},
        "readinessProbe":{"httpGet":{"path":"/healthz","port":"http"},"periodSeconds":5},
        "livenessProbe":{"httpGet":{"path":"/healthz","port":"http"},"initialDelaySeconds":10,"periodSeconds":15},
        "volumeMounts":[{"name":"site","mountPath":"/usr/share/nginx/html","readOnly":true},{"name":"config","mountPath":"/etc/nginx/nginx.conf","subPath":"nginx.conf","readOnly":true},{"name":"tmp","mountPath":"/tmp"}]}],
      "volumes":[{"name":"site","configMap":{"name":"landing-page"}},{"name":"config","configMap":{"name":"landing-nginx"}},{"name":"tmp","emptyDir":{"sizeLimit":"32Mi"}}]
    }}
  }},
  {"apiVersion":"v1","kind":"Service","metadata":{"name":"landing-page-service"},"spec":{"type":"ClusterIP","selector":{"app":"landing-page"},"ports":[{"name":"http","protocol":"TCP","port":80,"targetPort":"http"}]}}
]
